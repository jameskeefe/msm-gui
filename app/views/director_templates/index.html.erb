<h1>
  List of all directors
</h1>

<hr>

<form method='post' action='insert_movie'>
<div>
<label for = "title_field">Title</label>
<input type="text" id = "title_field" name="the_title" >
</div>
<div>
<label for = "year_field">Year</label>
<input type="text" id = "year_field" name="the_year" >
</div>
<div>
<label for = "duration_field">Duration</label>
<input type="text" id = "duration_field" name="the_duration" >
</div>
<div>
<label for = "description_field">Description</label>
<input type="text" id = "description_field" name="the_description" >
</div>
<div>
<label for = "image_field">Image</label>
<input type="text" id = "image_field" name="the_image" >
</div>
<div>
<label for = "director_field">Director ID</label>
<input type="text" id = "director_field" name="the_director_id" >
</div>
<div>
<button>Create movie</button>
</div>
</form>

<hr>

<table border="1">
  <tr>
    <th>
      ID
    </th>

    <th>
      Image
    </th>

    <th>
      Name
    </th>

    <th>
      Dob
    </th>

    <th>
    </th>
  </tr>

  <% @list_of_directors.order({:dob => :desc}).each do |director| %>
  <tr>
    <td>
      <%= director.id %>
    </td>

    <td>
      <img src="<%= director.image %>" style="width:250px;">
    </td>

    <td>
      <%= director.name %>
    </td>

    <td>
      <%= director.dob %>
    </td>

    <td>
      <a href="/directors/<%= director.id %>">
        Show details
      </a>
    </td>
  </tr>
  <% end %>
</table>
